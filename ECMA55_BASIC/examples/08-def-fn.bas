100 REM FUNCOES DEFINIDAS PELO USUARIO. O PARAMETRO E LOCAL A DEFINICAO.
110 DEF FNQ(X) = X * X
120 DEF FNC(X) = X * X * X
130 FOR N = 1 TO 5
140   PRINT N; "AO QUADRADO ="; FNQ(N); "  AO CUBO ="; FNC(N)
150 NEXT N
160 REM UMA FUNCAO SEM PARAMETRO
170 DEF FNP = 3.14159
180 PRINT "AREA DE UM CIRCULO DE RAIO 5: "; FNP * FNQ(5)
190 END
