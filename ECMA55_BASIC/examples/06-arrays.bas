100 REM ARRAYS DE UMA E DUAS DIMENSOES
110 DIM N(5)
120 FOR I = 1 TO 5
130   PRINT "NOTA "; I; ":"
140   INPUT N(I)
150 NEXT I
160 LET S = 0
170 FOR I = 1 TO 5
180   LET S = S + N(I)
190 NEXT I
200 PRINT "MEDIA: "; S / 5
210 REM UM TABULEIRO 3X3 COMO ARRAY BIDIMENSIONAL
220 DIM M(3, 3)
230 FOR L = 1 TO 3
240   FOR C = 1 TO 3
250     LET M(L, C) = L * 10 + C
260   NEXT C
270 NEXT L
280 FOR L = 1 TO 3
290   FOR C = 1 TO 3
300     PRINT M(L, C);
310   NEXT C
320   PRINT
330 NEXT L
340 END
