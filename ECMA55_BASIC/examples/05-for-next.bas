100 REM LACOS FOR/NEXT, INCLUINDO ANINHADOS E STEP NEGATIVO
110 PRINT "CONTANDO DE 1 A 5:"
120 FOR I = 1 TO 5
130   PRINT I
140 NEXT I
150 PRINT
160 PRINT "CONTANDO DE 10 A 2, DE 2 EM 2, PARA TRAS:"
170 FOR I = 10 TO 2 STEP -2
180   PRINT I
190 NEXT I
200 PRINT
210 PRINT "TABUADA DE MULTIPLICAR (1 A 3):"
220 FOR I = 1 TO 3
230   FOR J = 1 TO 3
240     PRINT I; "X"; J; "="; I * J
250   NEXT J
260 NEXT I
270 END
