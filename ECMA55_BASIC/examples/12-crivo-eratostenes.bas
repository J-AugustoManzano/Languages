100 REM CRIVO DE ERATOSTENES: PROGRAMA CLASSICO QUE JUNTA VARIOS
110 REM RECURSOS DA LINGUAGEM (ARRAY, FOR/NEXT, IF/GOTO, PRINT COM ,)
120 LET L = 100
130 DIM N(100)
140 FOR I = 1 TO L
150   LET N(I) = I
160 NEXT I
170 LET P = 2
180 PRINT P,
190 FOR I = P TO L STEP P
200   LET N(I) = 0
210 NEXT I
220 LET P = P + 1
230 IF P = L THEN 260
240 IF N(P) <> 0 THEN 180
250 GOTO 220
260 PRINT
270 END
