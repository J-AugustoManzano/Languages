100 REM GOSUB/RETURN: UMA SUB-ROTINA REUTILIZAVEL EM VARIOS PONTOS
110 LET A = 6
120 LET B = 1
130 LET C = -12
140 GOSUB 500
150 PRINT "RAIZES DE "; A; "X^2 + "; B; "X + "; C; ": "; R0; " E "; R1
160 LET A = 1
170 LET B = -3
180 LET C = 2
190 GOSUB 500
200 PRINT "RAIZES DE "; A; "X^2 + "; B; "X + "; C; ": "; R0; " E "; R1
210 STOP
500 REM SUB-ROTINA: RAIZES DE EQUACAO DO 2O GRAU (DISCRIMINANTE >= 0)
510 LET D = SQR(B^2 - 4*A*C)
520 LET R0 = (-B + D) / (2*A)
530 LET R1 = (-B - D) / (2*A)
540 RETURN
550 END
